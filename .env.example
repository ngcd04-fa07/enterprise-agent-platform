# Copy to .env and fill in real values for local development.
# Never commit .env.

# --- Postgres (docker compose local dev) ---
POSTGRES_USER=enterprise_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enterprise_agent

# --- API (apps/api) ---
# Used directly when running the API outside docker compose (venv + uvicorn).
# Inside docker compose, DATABASE_URL is derived from the Postgres vars above.
DATABASE_URL=postgresql+asyncpg://enterprise_agent:change-me@localhost:5432/enterprise_agent
# Stage 20: must be at least 32 characters (a length floor, not an
# entropy check — the app refuses to start otherwise). Generate a real
# one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-characters
ENVIRONMENT=development
# Has a working default (./data/documents); only set this to override it.
# In docker compose the api service sets it to /data/documents on a named volume.
STORAGE_ROOT=./data/documents
MAX_UPLOAD_SIZE_BYTES=26214400
# Stage 21: which ObjectStorage implementation is used (see
# app/storage/factory.py). "filesystem" (default) needs nothing else
# below. "s3" works against real AWS S3 (leave S3_ENDPOINT_URL unset) or
# any S3-compatible service like MinIO (set S3_ENDPOINT_URL to it) —
# credentials come from boto3's own standard credential chain
# (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, a shared config
# file, or an instance/task role), never a setting in this file.
STORAGE_BACKEND=filesystem
# S3_BUCKET_NAME=my-bucket
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION=us-east-1
# Stage 20: global ASGI-level request-body ceiling (enforced before any
# route/Pydantic validation) — must stay >= MAX_UPLOAD_SIZE_BYTES (the
# app fails loudly at startup otherwise). Has a working default; only
# set this to override it.
MAX_REQUEST_BODY_BYTES=31457280
# Stage 20: PDF ingestion resource ceilings — file size alone doesn't
# bound either. Have working defaults; only set these to override them.
MAX_PDF_PAGES=500
MAX_CHUNKS_PER_DOCUMENT=2000
# Stage 20: in-memory login/register rate limiting (see
# app/security/rate_limiter.py) — two independent login buckets so an
# attacker can never lock a victim out just by guessing their email from
# elsewhere. Have working defaults; only set these to override them.
LOGIN_RATE_LIMIT_PER_IP_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_PER_IP_WINDOW_SECONDS=60.0
LOGIN_RATE_LIMIT_PER_IDENTIFIER_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_PER_IDENTIFIER_WINDOW_SECONDS=300.0
REGISTER_RATE_LIMIT_PER_IP_MAX_ATTEMPTS=5
REGISTER_RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600.0
# Structured extraction (Stage 9) uses a local, open-source model via Ollama
# — no API key. Requires Ollama running separately (`ollama serve`) with the
# model pulled (`ollama pull qwen2.5:3b`); the API itself starts fine without
# it, but POST /submissions/{id}/extract returns status "failed" until it's
# reachable. Has working defaults; only set these to override them.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Model routing (Stage 16): a second, larger local model RoutingLLMGateway
# escalates to for reasoning-heavy calls (triage summary, eval judging) and
# on fast-tier failure. Pull it the same way: `ollama pull qwen2.5:14b`.
OLLAMA_CAPABLE_MODEL=qwen2.5:14b
# Model policy hardening (Stage 19): retry/timeout and per-tier circuit
# breaker tuning. Has working defaults (matching pre-Stage-19 behavior
# for the first two); only set these to override them.
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_MAX_ATTEMPTS=2
LLM_BREAKER_FAILURE_THRESHOLD=3
LLM_BREAKER_COOLDOWN_SECONDS=30.0

# --- Web (apps/web) ---
# Origin the Next.js server uses to reach the API directly (Server Components,
# docker compose service-to-service). Browser requests instead go through the
# same-origin /api/* rewrite — see apps/web/next.config.ts.
API_ORIGIN=http://localhost:8000
